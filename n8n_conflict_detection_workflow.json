{
  "name": "Détection des Conflits - Emploi du Temps (Horaire)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001",
      "name": "Schedule Trigger (Toutes les heures)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0002",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 460]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:9000/api/conflicts/",
        "options": {}
      },
      "id": "a1b2c3d4-0003",
      "name": "1. Appel API - Détection Conflits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:9000/api/conflicts/save/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004",
      "name": "2. Sauvegarde du Rapport (pour /conflicts/)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-total",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005",
      "name": "3. IF - Conflits Détectés ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, 380]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-1",
              "name": "resume",
              "value": "={{ $json.total }} conflit(s) détecté(s) : {{ $json.nb_enseignant }} enseignant, {{ $json.nb_salle }} salle, {{ $json.nb_classe }} classe. Voir le détail sur /conflicts/.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006",
      "name": "4a. Résumé (Conflits trouvés)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 280]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-2",
              "name": "resume",
              "value": "Aucun conflit détecté lors de cette vérification.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0007",
      "name": "4b. Résumé (Aucun conflit)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 480]
    }
  ],
  "connections": {
    "Schedule Trigger (Toutes les heures)": {
      "main": [
        [
          {
            "node": "1. Appel API - Détection Conflits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking \"Execute Workflow\"": {
      "main": [
        [
          {
            "node": "1. Appel API - Détection Conflits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Appel API - Détection Conflits": {
      "main": [
        [
          {
            "node": "2. Sauvegarde du Rapport (pour /conflicts/)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Sauvegarde du Rapport (pour /conflicts/)": {
      "main": [
        [
          {
            "node": "3. IF - Conflits Détectés ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. IF - Conflits Détectés ?": {
      "main": [
        [
          {
            "node": "4a. Résumé (Conflits trouvés)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "4b. Résumé (Aucun conflit)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
